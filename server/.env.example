# 클라이언트 모드와 공유하는 AES 키 파생용 passphrase (SecureChannel.java의 APP_SECRET과 동일한 값이어야 함)
APP_SECRET=change-me-to-a-long-random-value

# 관리자 API 인증 토큰 (X-Admin-Token 헤더)
ADMIN_TOKEN=change-me-to-a-long-random-value

# 디스코드 봇 토큰 (Bot 탭에서 발급, Message Content Intent 불필요 - 메시지만 보냄)
DISCORD_BOT_TOKEN=your-bot-token-here

# 로그를 게시할 채널 ID (채널 우클릭 > ID 복사, 개발자 모드 켜야 보임)
DISCORD_CHANNEL_ID=your-channel-id-here

# 모든 API 요청 시도(성공/실패 포함)를 기록할 개발자 로그 채널 ID (선택 - 비워두면 기록 안 함)
DISCORD_DEV_LOG_CHANNEL_ID=your-dev-log-channel-id-here

# 공용템 재고/보유 현황을 실시간으로 보여주는 대시보드 채널 ID (선택 - 비워두면 갱신 안 함)
DISCORD_INVENTORY_CHANNEL_ID=your-inventory-channel-id-here

# 로컬 개발 시 보통은 비워두면 됨 - server/storetracker.db에 고정 저장됨.
# 배포 시(예: Render + Neon)에는 Neon에서 발급받은 접속 문자열을 그대로 넣으면 됨.
# DATABASE_URL=sqlite:////absolute/path/to/storetracker.db
# DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/dbname?sslmode=require
